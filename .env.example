# ── AI provider (the brain) ──────────────────────────────────────────
# google | openai   (default: google). Picked up by lib/provider.ts — every model call
# in the app goes through chatModel()/reasoningProviderOptions()/webSearchTool(), so
# this one switch is the whole story. Image sticker generation and TTS voice notes
# stay OpenAI-only for now (see lib/stickers.ts createFromPrompt and lib/agent.ts
# send_voice_note) and are skipped gracefully — never thrown — while this is "google".
AI_PROVIDER=google

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any model your key can reach. gemini-2.5-flash is the default: fast, cheap, and
# tool/vision-capable. gemini-2.5-pro trades latency for depth if answers feel shallow.
BOT_MODEL=gemini-2.5-flash
# Naming a sticker is a narrow, bounded task, so it can run cheaper than replies.
# Falls back to BOT_MODEL when unset.
BOT_VISION_MODEL=gemini-2.5-flash
# Reasoning depth: minimal | low | medium | high   (default: low)
# Mapped in lib/provider.ts to a Gemini thinking-token budget: 0 / 1024 / 8192 / 24576.
BOT_EFFORT=low

# ── OpenAI (only used when AI_PROVIDER=openai, or for the phase-2-only image/voice
#    tools even under google — see the note above) ─────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Image model for drawn stickers. Needs a transparent background — the gpt-image-*
# family supports it, dall-e does not. The mini tier is ~80% cheaper and fine at
# 512x512, which is all a sticker ever is. Unused while AI_PROVIDER=google.
BOT_IMAGE_MODEL=gpt-image-1-mini
# Optional, USD per million tokens, for the cost estimate in `check_usage`. Known
# published rates are built in for gpt-5.6-sol / -terra / -luna; set these to price a
# model that has none (a bare alias, or after a price change). Tokens are always
# counted exactly — this only affects the money figure.
# OPENAI_PRICE_INPUT=5.00
# OPENAI_PRICE_OUTPUT=30.00

# ── Postgres (the memory) ────────────────────────────────────────────
# Tables are created automatically on first request.
DATABASE_URL=postgres://user:pass@host:5432/wspbot

# ── wapi (WhatsApp) ──────────────────────────────────────────────────
WAPI_BASE_URL=https://api.wapi.crafter.run
# Session API key — messaging. From the session's page in the wapi dashboard.
WAPI_API_KEY=
# Session webhook secret — proves inbound deliveries really came from wapi.
WAPI_WEBHOOK_SECRET=

# Account-level token plus the session id, used ONLY to reconnect a dropped session
# (`connect` is a session-admin route, and the session key gets a 403 there).
# Optional: leave blank and the bot still works, it just cannot heal itself after a
# drop. Note a PAT controls every session on the account.
WAPI_PAT=
WAPI_SESSION_ID=

# ── Google Sheets (optional) ─────────────────────────────────────────
# Reading a publicly-viewable sheet needs nothing at all. Writing needs a service
# account: an API key authorises read-only access to public data and cannot write,
# even to a sheet shared as "anyone with the link can edit".
#
#   1. Google Cloud console -> create a service account -> add a JSON key
#   2. Enable the Google Sheets API for that project
#   3. Share each sheet with the service account's email as an Editor
#
# Paste the downloaded JSON here on one line, keeping its 
 escapes as they are.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Notion (optional) ────────────────────────────────────────────────
# A public integration from https://www.notion.so/my-integrations, with its
# redirect URI set to <APP_URL>/api/notion/callback. Leave unset and the Notion
# tools are simply not offered.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Where this app is reachable; only needed if it is not the default.
# APP_URL=https://wspbot.crafter.run

# ── Dashboard sign-in ────────────────────────────────────────────────
# The page shows the chats' memories, the sticker library, the WhatsApp identity
# and what it has cost, so it is not public. The password is stored only as a
# bcrypt hash, and the hash is stored base64-encoded — a bcrypt hash contains '$', which Docker
# Compose interpolates away, leaving a truncated hash nobody can sign in against. Generate:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync(process.argv[1],12)).toString('base64'))" 'your-password'
# A raw hash is also accepted: fine locally, eaten in Compose.
ADMIN_USER=
ADMIN_PASSWORD_HASH=
# Signs the session cookie. Any long random string; changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# The model that writes scheduled summaries. Worth the top tier: it runs rarely, on a long
# transcript, and a digest that drops the decision everyone needed is worse than no digest.
# Defaults to gemini-2.5-flash; point it at gemini-2.5-pro for longer transcripts.
BOT_SUMMARY_MODEL=

# ── Behaviour ────────────────────────────────────────────────────────
# Answer one-to-one chats too. Off by default: the bot is a group tool, and a
# direct chat has no tagging convention, so it would answer everything sent to it.
BOT_REPLY_TO_DMS=false
# How often one person may set the bot working. Per-person overrides go in the
# rate_limits table; this is only the fallback for anyone not listed there.
BOT_RATE_LIMIT_PER_MINUTE=1
# Where the people in these chats live. Reminders are why it matters: "nine in the
# morning" is meaningless without it, and a UTC server would fire hours early.
BOT_TIMEZONE=UTC
# Comma-separated group JIDs (e.g. "123456789@g.us,987654321@g.us") the bot may act
# in. Checked in the webhook route before anything else, via lib/allowlist.ts
# isAllowedChat(). Empty or unset blocks every group — an allowlist that admits
# everyone until configured would let a fresh deployment answer in every group it is
# added to, the opposite of what "allowlist" promises. Has no effect on DMs, which
# BOT_REPLY_TO_DMS governs on its own.
BOT_GROUP_ALLOWLIST=
